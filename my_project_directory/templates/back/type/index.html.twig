
{% extends 'back/base.html.twig' %}

{% block body %}
<h1>Gestion des Types des items</h1>








<a class="btn btn-new" href="{{path('app_type_admin_new')}}">nouveau</a>

{% for message in app.flashes('error') %}
        {{ message }}
{% endfor%}

<div class="admin-card-crud">

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Nombre d'items </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
       {%for item in type %}
            <tr>
                <td>{{ item.id }}</td>
                <td>{{ item.label }}</td>
                <td>{{ item.nbItem }}</td>
                <td><a href="{{path('app_type_admin_show', {'id':item.id})}}"> <i class="fa-solid fa-pen"></i></a>
                
                
                </td>
            </tr> 
        {% endfor %}
 
            
        </tbody>
    </table>



    
{% endblock %}
