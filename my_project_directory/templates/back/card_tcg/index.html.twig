            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Date de sortie</th>
                <th>Date de creation</th>
                <th>Rareté</th>
                <th>Code</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>




</div>
{% endblock %}
